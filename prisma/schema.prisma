generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  walletAddress String    @unique
  createdAt     DateTime  @default(now())
  sessions      Session[]
}

model AuthNonce {
  id            String    @id @default(cuid())
  walletAddress String
  nonce         String    @unique
  message       String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([walletAddress, expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Draft {
  id             String   @id @default(cuid())
  creatorWallet  String?
  name           String
  symbol         String
  description    String
  genre          String
  twitter        String?
  telegram       String?
  website        String?
  imageFileId    String?
  characterJson  String
  chaptersJson   String
  tierJson       String
  metadataUri    String?
  imageCid       String?
  status         String   @default("draft")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
}

model Token {
  mint            String      @id
  name            String
  symbol          String
  description     String
  imageUrl        String
  metadataUri     String
  creatorWallet   String
  curveCreator    String?
  twitter         String?
  telegram        String?
  website         String?
  genre           String
  signature       String      @unique
  devBuySol       Float       @default(0)
  poolAtLaunch    String
  graduated       Boolean     @default(false)
  nextHolderGoal  Int?
  createdAt       DateTime    @default(now())
  character       Character?
  chapters        Chapter[]
  reports         Report[]
  observations    PricePoint[]

  @@index([createdAt])
  @@index([creatorWallet])
}

model Character {
  id          String @id @default(cuid())
  mint        String @unique
  name        String
  epithet     String
  premise     String
  voice       String
  appearance  String
  token       Token  @relation(fields: [mint], references: [mint], onDelete: Cascade)
}

model Chapter {
  id         String   @id @default(cuid())
  mint       String
  index      Int
  title      String
  body       String
  minTokens  String
  origin     String
  createdAt  DateTime @default(now())
  token      Token    @relation(fields: [mint], references: [mint], onDelete: Cascade)

  @@unique([mint, index])
  @@index([mint])
}

model Report {
  id        String   @id @default(cuid())
  mint      String
  wallet    String?
  reason    String
  detail    String
  createdAt DateTime @default(now())
  token     Token    @relation(fields: [mint], references: [mint], onDelete: Cascade)

  @@index([mint, createdAt])
}

model PricePoint {
  id        String   @id @default(cuid())
  mint      String
  priceUsd  String?
  marketCapUsd String?
  volumeUsd String?
  source    String
  observedAt DateTime @default(now())
  token     Token    @relation(fields: [mint], references: [mint], onDelete: Cascade)

  @@index([mint, observedAt])
}

model ChapterJob {
  id        String   @id @default(cuid())
  mint      String?
  status    String
  detail    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
