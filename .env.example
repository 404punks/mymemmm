# Postgres. Local docker-compose uses the credentials below.
DATABASE_URL="postgresql://veil:veil@localhost:5432/veil?schema=public"

# Public site URL. Used in token descriptions and absolute story links.
PUBLIC_APP_URL="http://localhost:3000"
# Same origin, exposed to the browser so the wallet adapter calls /api/rpc.
# Do not put the paid RPC URL in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Long random string. Sessions are invalid without it.
AUTH_SECRET="replace-with-a-long-random-string"

# Paid mainnet RPC. Production refuses api.mainnet-beta.solana.com.
# Helius: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# QuickNode: https://YOUR-ENDPOINT.solana-mainnet.quiknode.pro/YOUR_KEY/
SOLANA_RPC_URL=""

# Anthropic. Story generation does not run without this.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Pinata JWT. pump.fun no longer accepts its old IPFS upload API.
# https://pumpportal.fun/creation
PINATA_JWT=""

# Optional. PumpPortal's data websocket is documented with an API key and
# meters subscribeTokenTrade. The key stays on the server.
PUMPPORTAL_API_KEY=""

# Optional market holder counts. Without it, VEIL shows largest accounts only.
BIRDEYE_API_KEY=""

# Optional S3-compatible copy of character art. Pinata is still required for the mint URI.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Comma-separated ISO country codes. Uses x-vercel-ip-country or cf-ipcountry.
GEO_BLOCK_COUNTRIES=""

# Protects /api/cron/chapters. Vercel Cron sends Authorization: Bearer $CRON_SECRET.
CRON_SECRET=""

# Holder count that must be reached before chapter 5 is written. Later chapters step up.
CHAPTER_HOLDER_GOAL="100"
CHAPTER_HOLDER_STEP="150"
