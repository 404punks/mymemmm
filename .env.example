# NEURALPAD environment
# Copy to .env. Never commit real secrets.

# SQLite is the default so the app runs without extra services.
# Production: use PostgreSQL and change prisma/schema.prisma datasource provider to "postgresql".
# SQLite paths are resolved from prisma/schema.prisma. This file is prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Public origin used in metadata URIs. Pump metadata URIs must be <= 200 characters.
# A localhost URI confirms on-chain but Pump's indexer cannot fetch it.
PUBLIC_APP_URL="http://localhost:3000"

# Session signing material. Generate a long random string before any shared deployment.
AUTH_SECRET="replace-with-a-long-random-string"

# Optional admin key for index triggers and usage reports.
ADMIN_API_KEY=""

# Solana. Development stays on devnet. Mainnet transaction building stays disabled
# until ALLOW_MAINNET=true. This repository never sends a mainnet transaction on its own.
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_RPC_URL_MAINNET=""
SOLANA_NETWORK="devnet"
ALLOW_MAINNET="false"
# Optional indexer with holder data. Without it, holder concentration is omitted.
HELIUS_API_KEY=""

# AI providers. Requests run only on the server. Leave blank to keep AI routes in
# an explicit unavailable state (no fabricated model output).
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
# Comma-separated provider:model allowlist. Unknown models are rejected.
AI_MODEL_ALLOWLIST="openai:gpt-4o-mini,anthropic:claude-3-5-haiku-latest"
AI_DAILY_LIMIT="200"
AI_TIMEOUT_MS="25000"
AI_COST_PER_1K_INPUT="0.00015"
AI_COST_PER_1K_OUTPUT="0.0006"

# Public GitHub token used only to raise rate limits on public search.
# Do not use a token that can read private repositories.
GITHUB_TOKEN=""
HUGGINGFACE_TOKEN=""

# Index source endpoints.
MCP_REGISTRY_URL="https://registry.modelcontextprotocol.io/v0.1/servers"
INDEX_PAGE_SIZE="15"

# Optional social links. Empty values are omitted from the footer.
NEXT_PUBLIC_SOCIAL_X=""
NEXT_PUBLIC_SOCIAL_GITHUB=""
NEXT_PUBLIC_ALLOW_MAINNET="false"
NEXT_PUBLIC_DEFAULT_NETWORK="devnet"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"
NEXT_PUBLIC_SOLANA_RPC_URL_MAINNET=""

# Set to true in local development to allow POST /api/index/jobs without ADMIN_API_KEY.
ALLOW_INDEX_TRIGGER="true"
