{
  "name": "veil",
  "version": "1.0.0",
  "private": true,
  "description": "VEIL — an AI mystery token launchpad. Every coin is created on pump.fun, Solana mainnet, and signed in the user's wallet.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e.mainnet.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@prisma/client": "^6.16.2",
    "@pump-fun/pump-sdk": "4.0.0",
