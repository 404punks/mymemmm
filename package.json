    "framer-motion": "^12.43.0",
    "nanoid": "^5.1.6",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "tweetnacl": "^1.0.3",
    "zod": "^3.25.76"
